{
  "manifest_version": 2,
  "name": "Amiga-inspired Lila Night",
  "version": "1.0",
  "description": "Dark lilac Firefox theme matching the Amiga-inspired Lila Night COSMIC theme and terminal colors.",
  "browser_specific_settings": { "gecko": { "id": "amiga-lila-night@blazingfarts" } },
  "theme": {
    "images": { "theme_frame": "images/kopf.png" },
    "colors": {
      "frame": "#1D1828",
      "frame_inactive": "#262033",
      "tab_background_text": "#E6DEF2",
      "tab_selected": "#312A41",
      "tab_text": "#F0EAF8",
      "tab_line": "#E57CC4",
      "tab_loading": "#E57CC4",
      "tab_background_separator": "#3B3350",
      "toolbar": "#262033",
      "toolbar_text": "#F0EAF8",
      "toolbar_top_separator": "#3B3350",
      "toolbar_bottom_separator": "#3B3350",
      "toolbar_vertical_separator": "#3B3350",
      "toolbar_field": "#1D1828",
      "toolbar_field_text": "#F0EAF8",
      "toolbar_field_border": "#3B3350",
      "toolbar_field_focus": "#1D1828",
      "toolbar_field_text_focus": "#FFFFFF",
      "toolbar_field_border_focus": "#B48CF2",
      "toolbar_field_highlight": "#B48CF2",
      "toolbar_field_highlight_text": "#1D1828",
      "icons": "#D8CCEC",
      "icons_attention": "#E57CC4",
      "button_background_hover": "#3B3350",
      "button_background_active": "#4A4060",
      "popup": "#262033",
      "popup_text": "#F0EAF8",
      "popup_border": "#3B3350",
      "popup_highlight": "#B48CF2",
      "popup_highlight_text": "#1D1828",
      "sidebar": "#1D1828",
      "sidebar_text": "#F0EAF8",
      "sidebar_border": "#3B3350",
      "sidebar_highlight": "#B48CF2",
      "sidebar_highlight_text": "#1D1828",
      "ntp_background": "#1D1828",
      "ntp_text": "#F0EAF8",
      "ntp_card_background": "#262033"
    },
    "properties": { "color_scheme": "dark", "content_color_scheme": "dark" }
  }
}
